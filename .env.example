# Copy this file to .env and fill in the credentials you have available.
# Missing values simply disable that provider.

# Required for Wiley downloads
WILEY_TDM_TOKEN=

# Required for Elsevier downloads
ELSEVIER_API_KEY=

# Optional: enables Springer open-access downloads
SPRINGER_API_KEY=

# Contact information for polite API usage
CROSSREF_MAILTO=
OPENALEX_MAILTO=

# Optional: enable Unpaywall fallback for open-access copies
UNPAYWALL_EMAIL=

# Optional: seconds between Crossref PDF requests (default 4.0)
CROSSREF_REQUEST_DELAY=

# Optional: seconds between Wiley requests (default 2.5)
WILEY_REQUEST_DELAY=

# --- Browser fallback (Playwright, opt-in via --use-browser-fallback) ----------
# Set BROWSER_FALLBACK_ENABLED=0 to globally disable the fallback even when the
# CLI flag is passed (useful in CI environments without a display).
BROWSER_FALLBACK_ENABLED=

# Force headless/headed mode. Default: headed on ACS/Wiley, headless elsewhere
# when no DISPLAY is set. Values: 1 (headless) / 0 (headed) / unset (auto).
BROWSER_FALLBACK_HEADLESS=

# Browser channel. Default: chromium (cross-platform). Set to 'msedge' to reuse
# an existing Edge profile (Windows-friendly, mirrors ref-downloader's setup).
BROWSER_FALLBACK_CHANNEL=

# Persistent profile dir for cookies/SSO. Default: ~/.cache/auto_paper_download/browser_profile
BROWSER_FALLBACK_PROFILE=

# Extra hostname substrings that mean 'we got bounced to SSO'. Comma-separated.
# Useful for adding your institution's specific login domain, e.g.:
# BROWSER_FALLBACK_AUTH_HOSTS=login.uni.edu,idp.cnki.net
BROWSER_FALLBACK_AUTH_HOSTS=

